{
  "name": "pagesbot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev dist",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply zgb-trpg --local",
    "db:migrate:remote": "wrangler d1 migrations apply zgb-trpg --remote",
    "check:api": "node --check functions/api/[[path]].js"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
